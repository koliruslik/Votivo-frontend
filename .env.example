PORT=4300
PUBLIC_ORIGIN=http://localhost:4200
POLL_URL=http://localhost:18082
VOTE_URL=http://localhost:18083
RESULT_URL=http://localhost:18084
KEYCLOAK_ISSUER=http://localhost:18080/realms/votivo
KEYCLOAK_JWKS_URL=http://localhost:18080/realms/votivo/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=poll-service
# Shared with Poll, Vote and Result; they accept only calls that carry it. Required.
INTERNAL_AUTH_SECRET=replace_with_a_long_random_secret
# Accept only DPoP-bound access tokens (keep true while the Keycloak client binds tokens).
REQUIRE_DPOP=true
